<% content_for :title, "RSVP" %>
<% responded = @invite_group.guests.any? { |g| !g.attending.nil? } %>
<section class="max-w-2xl mx-auto px-6 py-20">
  <div class="text-center mb-12">
    <h1 class="font-serif font-light text-5xl text-nasturtium-forest mb-2"><%= @invite_group.name %></h1>
    <div class="w-12 h-px bg-nasturtium-olive mx-auto mt-4 mb-6"></div>
    <% if responded %>
      <p class="text-nasturtium-sage text-lg">Here's your RSVP. You can update it anytime before August 10th.</p>
    <% else %>
      <p class="text-nasturtium-sage text-lg">We found your invitation — we'd love to know if you can join us.</p>
    <% end %>
  </div>

  <div class="space-y-8">
    <% @invite_group.guests.select { |g| g.plus_one_host_id.nil? }.each do |guest| %>
      <div class="border-b border-nasturtium-linen pb-6 last:border-b-0">
        <div class="flex items-baseline justify-between">
          <h2 class="font-serif text-xl text-nasturtium-forest"><%= guest.full_name %></h2>
          <% if guest.attending %>
            <span class="text-nasturtium-sage text-sm">Attending</span>
          <% elsif guest.attending == false %>
            <span class="text-nasturtium-red/70 text-sm">Not attending</span>
          <% else %>
            <span class="text-nasturtium-golden text-sm">No response</span>
          <% end %>
        </div>

        <% if guest.attending %>
          <% attending_events = guest.event_responses.select(&:attending).map { |er| @events.find { |e| e.id == er.event_id }&.name }.compact %>
          <% if attending_events.any? %>
            <p class="text-nasturtium-sage text-sm mt-2">Events: <%= attending_events.join(", ") %></p>
          <% else %>
            <p class="text-nasturtium-sage/70 text-sm mt-2">No events selected yet.</p>
          <% end %>
          <% if guest.plus_one_guest.present? %>
            <p class="text-nasturtium-sage text-sm mt-1">Plus one: <%= guest.plus_one_guest.full_name %></p>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @invite_group.email.present? %>
    <p class="text-nasturtium-sage/70 text-sm text-center mt-8">
      We'll send wedding updates to <%= @invite_group.email %>.
    </p>
  <% end %>

  <% if @invite_group.weecasa_included? %>
    <%= render "weecasa_panel", group: @invite_group, f: nil %>
  <% end %>

  <div class="text-center mt-12">
    <% if responded %>
      <%= link_to "Update my RSVP", form_invite_group_path(@invite_group),
          class: "text-nasturtium-sage hover:text-nasturtium-forest text-sm tracking-widest uppercase transition-colors" %>
    <% else %>
      <%= link_to "RSVP now", form_invite_group_path(@invite_group),
          class: "inline-block bg-chartreuse text-nasturtium-forest-dark font-serif text-xl px-12 py-3 rounded hover:bg-nasturtium-olive transition-colors" %>
    <% end %>
  </div>
</section>
