<div class="flex items-center justify-between mb-8">
  <h1 class="text-2xl font-semibold">Import guests</h1>
  <%= link_to "Back", admin_guests_path, class: "text-sm text-gray-600 hover:underline" %>
</div>

<% if @errors.any? %>
  <div class="mb-6 rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
    <p class="font-semibold mb-2">Import failed &mdash; nothing was saved:</p>
    <ul class="list-disc list-inside space-y-1">
      <% @errors.each do |err| %>
        <li><%= err %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="bg-white border border-gray-200 rounded p-6">
  <div class="mb-4 text-sm text-gray-600">
    <p class="mb-2">
      Paste CSV content below. The first row must be a header row with these exact columns:
    </p>
    <code class="block bg-gray-100 text-gray-800 text-xs px-3 py-2 rounded">
      group_name,group_address,first_name,last_name,email,phone,dietary_notes
    </code>
    <p class="mt-3 text-xs text-gray-500">
      Guests sharing the same <code>group_name</code> are grouped together. If any row fails validation,
      the entire import is rolled back.
    </p>
  </div>

  <%= form_with url: admin_guest_import_path, method: :post, local: true, class: "space-y-4" do |f| %>
    <%= f.text_area :csv_text,
        value: @csv_text,
        rows: 16,
        placeholder: "group_name,group_address,first_name,last_name,email,phone,dietary_notes\nSmith Family,123 Main St,Jane,Smith,jane@example.com,555-1234,vegetarian",
        class: "w-full font-mono text-xs border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>

    <div class="flex items-center gap-3">
      <%= f.submit "Import", class: "bg-gray-900 text-white text-sm px-4 py-2 rounded hover:bg-gray-700 cursor-pointer" %>
      <%= link_to "Cancel", admin_guests_path, class: "text-sm text-gray-600 hover:underline" %>
    </div>
  <% end %>
</div>
