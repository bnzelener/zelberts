<section class="max-w-5xl mx-auto px-6 py-12">
  <h1 class="font-serif font-light text-4xl text-nasturtium-forest mb-8">RSVP Responses</h1>

  <%# Summary cards %>
  <div class="grid grid-cols-3 gap-6 mb-10">
    <div class="text-center p-6 bg-nasturtium-olive/10 rounded">
      <p class="font-serif text-3xl text-nasturtium-forest"><%= @attending_count %></p>
      <p class="text-xs tracking-[0.2em] uppercase text-nasturtium-sage mt-1">Attending</p>
    </div>
    <div class="text-center p-6 bg-nasturtium-red/5 rounded">
      <p class="font-serif text-3xl text-nasturtium-red"><%= @not_attending_count %></p>
      <p class="text-xs tracking-[0.2em] uppercase text-nasturtium-sage mt-1">Declined</p>
    </div>
    <div class="text-center p-6 bg-nasturtium-honey/10 rounded">
      <p class="font-serif text-3xl text-nasturtium-golden"><%= @pending_count %></p>
      <p class="text-xs tracking-[0.2em] uppercase text-nasturtium-sage mt-1">Pending</p>
    </div>
  </div>

  <%# Search %>
  <%= form_with url: admin_guests_path, method: :get, class: "mb-6" do |f| %>
    <%= f.hidden_field :view, value: @view %>
    <div class="flex gap-3">
      <%= f.search_field :q, value: @query, placeholder: "Search by name or email",
            class: "flex-1 border-b border-nasturtium-forest/20 bg-transparent py-2 text-nasturtium-forest-dark font-body focus:border-nasturtium-forest focus:outline-none transition-colors" %>
      <%= f.submit "Search",
            class: "bg-nasturtium-forest text-nasturtium-cream px-6 py-2 text-xs tracking-[0.2em] uppercase hover:bg-nasturtium-forest-light transition-colors cursor-pointer" %>
      <% if @query.present? %>
        <%= link_to "Clear", admin_guests_path(view: @view),
              class: "px-6 py-2 text-xs tracking-[0.2em] uppercase text-nasturtium-sage hover:text-nasturtium-forest self-center" %>
      <% end %>
    </div>
  <% end %>

  <% if @query.present? %>
    <p class="text-nasturtium-sage text-sm mb-4">Showing results for &ldquo;<%= @query %>&rdquo;.</p>
  <% end %>

  <%# View toggle %>
  <div class="inline-flex rounded border border-nasturtium-forest/20 overflow-hidden mb-6">
    <%= link_to "By guest", admin_guests_path(view: "guests", q: @query.presence),
          class: "px-4 py-2 text-xs tracking-[0.2em] uppercase #{@view == "guests" ? "bg-nasturtium-forest text-nasturtium-linen" : "text-nasturtium-sage hover:bg-nasturtium-olive/10"}" %>
    <%= link_to "By group", admin_guests_path(view: "groups", q: @query.presence),
          class: "px-4 py-2 text-xs tracking-[0.2em] uppercase #{@view == "groups" ? "bg-nasturtium-forest text-nasturtium-linen" : "text-nasturtium-sage hover:bg-nasturtium-olive/10"}" %>
  </div>

  <% if @view == "groups" %>
    <%# Group table — one invite group per line %>
    <% if @invite_groups.any? || @ungrouped_guests.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-nasturtium-forest/20">
              <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Group</th>
              <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Members</th>
              <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Address</th>
              <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Email</th>
              <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Responses</th>
              <th class="py-3 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal"></th>
            </tr>
          </thead>
          <tbody>
            <% @invite_groups.each do |group| %>
              <tr class="border-b border-nasturtium-linen">
                <td class="py-4 pr-4 text-nasturtium-forest-dark font-medium align-top">
                  <%= link_to group.name, admin_invite_group_path(group), class: "text-nasturtium-forest hover:text-nasturtium-sage underline" %>
                  <% if group.weecasa_included? %>
                    <span class="ml-1 inline-block text-[10px] tracking-[0.15em] uppercase text-nasturtium-olive border border-nasturtium-olive/40 rounded px-1.5 py-0.5 align-middle">WeeCasa</span>
                  <% end %>
                </td>
                <td class="py-4 pr-4 text-nasturtium-sage text-sm align-top"><%= group.guests.map(&:full_name).join(", ").presence || "—" %></td>
                <td class="py-4 pr-4 text-nasturtium-sage text-sm align-top"><%= group.address.presence || "—" %></td>
                <td class="py-4 pr-4 text-nasturtium-sage text-sm align-top"><%= group.email.presence || "—" %></td>
                <td class="py-4 pr-4 text-nasturtium-sage text-sm align-top">
                  <%= group.guests.count(&:attending) %> attending ·
                  <%= group.guests.count { |g| g.attending == false } %> declined ·
                  <%= group.guests.count { |g| g.attending.nil? } %> pending
                </td>
                <td class="py-4 text-sm align-top">
                  <%= button_to "Delete", admin_invite_group_path(group),
                        method: :delete,
                        form: { data: { turbo_confirm: "Delete #{group.name}? This also deletes its #{group.guests.size} guest#{"s" unless group.guests.size == 1} and their responses. This cannot be undone." }, class: "inline" },
                        class: "text-nasturtium-red/80 hover:text-nasturtium-red hover:underline bg-transparent p-0 border-0 cursor-pointer" %>
                </td>
              </tr>
            <% end %>
            <% @ungrouped_guests.each do |guest| %>
              <tr class="border-b border-nasturtium-linen">
                <td class="py-4 pr-4 text-nasturtium-sage italic align-top">No group</td>
                <td class="py-4 pr-4 text-nasturtium-sage text-sm align-top"><%= guest.full_name %></td>
                <td class="py-4 pr-4 text-nasturtium-sage text-sm align-top">—</td>
                <td class="py-4 pr-4 text-nasturtium-sage text-sm align-top">—</td>
                <td class="py-4 pr-4 text-nasturtium-sage text-sm align-top">
                  <% if guest.attending.nil? %>Pending<% elsif guest.attending? %>Attending<% else %>Declined<% end %>
                </td>
                <td class="py-4 text-sm align-top"></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-nasturtium-sage text-center py-12"><%= @query.present? ? "No groups match your search." : "No groups yet." %></p>
    <% end %>

  <%# Guest table — one guest per line %>
  <% elsif @guests.any? %>
    <div class="overflow-x-auto">
      <table class="w-full text-left">
        <thead>
          <tr class="border-b border-nasturtium-forest/20">
            <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Name</th>
            <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Group</th>
            <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Address</th>
            <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Email</th>
            <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Phone</th>
            <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Status</th>
            <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Dietary</th>
            <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Plus One</th>
            <th class="py-3 pr-4 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal">Responded</th>
            <th class="py-3 text-xs tracking-[0.2em] uppercase text-nasturtium-sage font-normal"></th>
          </tr>
        </thead>
        <tbody>
          <% @guests.each do |guest| %>
            <tr class="border-b border-nasturtium-linen">
              <td class="py-4 pr-4 text-nasturtium-forest-dark font-medium"><%= guest.full_name %></td>
              <td class="py-4 pr-4 text-nasturtium-sage text-sm"><%= guest.invite_group&.name || "—" %></td>
              <td class="py-4 pr-4 text-nasturtium-sage text-sm"><%= guest.invite_group&.address.presence || "—" %></td>
              <td class="py-4 pr-4 text-nasturtium-sage text-sm"><%= guest.invite_group&.email || "—" %></td>
              <td class="py-4 pr-4 text-nasturtium-sage text-sm"><%= guest.phone.presence || "—" %></td>
              <td class="py-4 pr-4">
                <% if guest.attending.nil? %>
                  <span class="text-nasturtium-golden text-sm">Pending</span>
                <% elsif guest.attending? %>
                  <span class="text-nasturtium-sage text-sm">Attending</span>
                <% else %>
                  <span class="text-nasturtium-red/70 text-sm">Declined</span>
                <% end %>
              </td>
              <td class="py-4 pr-4 text-nasturtium-sage text-sm"><%= guest.dietary_notes.presence || "—" %></td>
              <td class="py-4 pr-4 text-nasturtium-sage text-sm">
                <% if guest.plus_one? && guest.plus_one_name.present? %>
                  <%= guest.plus_one_name %>
                <% elsif guest.plus_one_allowed? %>
                  <span class="text-nasturtium-olive">Allowed</span>
                <% else %>
                  —
                <% end %>
              </td>
              <td class="py-4 pr-4 text-nasturtium-sage text-sm"><%= guest.responded_at&.strftime("%b %e, %Y") || "—" %></td>
              <td class="py-4 text-sm"><%= link_to "Edit", edit_admin_guest_path(guest), class: "text-nasturtium-forest hover:text-nasturtium-sage underline" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-nasturtium-sage text-center py-12"><%= @query.present? ? "No guests match your search." : "No responses yet." %></p>
  <% end %>
</section>
