<%= form_with(model: [:admin, event], local: true, class: "space-y-5 bg-white border border-gray-200 rounded p-6") do |f| %>
  <% if event.errors.any? %>
    <div class="rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <p class="font-semibold mb-2"><%= pluralize(event.errors.count, "error") %> prevented saving:</p>
      <ul class="list-disc list-inside">
        <% event.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div>
      <%= f.label :date, class: "block text-sm font-medium mb-1" %>
      <%= f.date_field :date, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
    </div>
    <div>
      <%= f.label :time, class: "block text-sm font-medium mb-1" %>
      <%= f.text_field :time, placeholder: "5:00 PM", class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
    </div>
  </div>

  <div>
    <%= f.label :location, class: "block text-sm font-medium mb-1" %>
    <%= f.text_field :location, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
  </div>

  <div>
    <%= f.label :address, class: "block text-sm font-medium mb-1" %>
    <%= f.text_field :address, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium mb-1" %>
    <%= f.text_area :description, rows: 4, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
  </div>

  <div>
    <%= f.label :sort_order, "Sort order", class: "block text-sm font-medium mb-1" %>
    <%= f.number_field :sort_order, class: "w-32 border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "bg-gray-900 text-white text-sm px-4 py-2 rounded hover:bg-gray-700 cursor-pointer" %>
    <%= link_to "Cancel", admin_events_path, class: "text-sm text-gray-600 hover:underline" %>
  </div>
<% end %>
