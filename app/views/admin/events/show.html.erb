<div class="flex items-center justify-between mb-2">
  <h1 class="text-2xl font-semibold"><%= @event.name %></h1>
  <div class="space-x-3">
    <%= link_to "Edit", edit_admin_event_path(@event), class: "text-sm text-blue-600 hover:underline" %>
    <%= link_to "Back", admin_events_path, class: "text-sm text-gray-600 hover:underline" %>
  </div>
</div>
<p class="text-gray-500 text-sm mb-8">
  <%= [ @event.date&.strftime("%A, %B %e, %Y"), @event.time, @event.location ].compact.join(" · ") %>
</p>

<div class="bg-white border border-gray-200 rounded p-6 mb-6">
  <p class="text-3xl font-semibold"><%= @attending_guests.size %></p>
  <p class="text-xs uppercase tracking-wider text-gray-500 mt-1">
    Guest<%= "s" unless @attending_guests.size == 1 %> attending this event
  </p>
</div>

<% if @attending_guests.any? %>
  <div class="bg-white border border-gray-200 rounded overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs uppercase tracking-wider text-gray-500">
        <tr>
          <th class="px-4 py-3">Name</th>
          <th class="px-4 py-3">Group</th>
          <th class="px-4 py-3">Plus one</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @attending_guests.each do |guest| %>
          <tr>
            <td class="px-4 py-3 font-medium"><%= guest.full_name %></td>
            <td class="px-4 py-3 text-gray-600"><%= guest.invite_group&.name || "—" %></td>
            <td class="px-4 py-3 text-gray-600"><%= guest.plus_one_guest&.full_name || "—" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white border border-gray-200 rounded p-8 text-center text-gray-500">
    No guests have RSVP'd to this event yet.
  </div>
<% end %>
