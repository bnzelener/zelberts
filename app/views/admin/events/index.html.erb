<div class="flex items-center justify-between mb-8">
  <h1 class="text-2xl font-semibold">Schedule</h1>
  <%= link_to "New event", new_admin_event_path,
      class: "inline-block bg-gray-900 text-white text-sm px-4 py-2 rounded hover:bg-gray-700" %>
</div>

<% if @events.any? %>
  <div class="bg-white border border-gray-200 rounded overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-gray-50 text-left text-xs uppercase tracking-wider text-gray-500">
        <tr>
          <th class="px-4 py-3">Order</th>
          <th class="px-4 py-3">Name</th>
          <th class="px-4 py-3">Date</th>
          <th class="px-4 py-3">Time</th>
          <th class="px-4 py-3">Location</th>
          <th class="px-4 py-3 text-right">Attending</th>
          <th class="px-4 py-3 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @events.each do |event| %>
          <tr>
            <td class="px-4 py-3 text-gray-500"><%= event.sort_order %></td>
            <td class="px-4 py-3 font-medium">
              <%= link_to event.name, admin_event_path(event), class: "text-blue-600 hover:underline" %>
            </td>
            <td class="px-4 py-3"><%= event.date&.strftime("%b %e, %Y") %></td>
            <td class="px-4 py-3"><%= event.time %></td>
            <td class="px-4 py-3 text-gray-600"><%= event.location %></td>
            <td class="px-4 py-3 text-right tabular-nums"><%= @attending_counts[event.id] || 0 %></td>
            <td class="px-4 py-3 text-right space-x-3">
              <%= link_to "View", admin_event_path(event), class: "text-blue-600 hover:underline" %>
              <%= link_to "Edit", edit_admin_event_path(event), class: "text-blue-600 hover:underline" %>
              <%= button_to "Delete", admin_event_path(event),
                  method: :delete,
                  form: { data: { turbo_confirm: "Delete this event?" }, class: "inline" },
                  class: "text-red-600 hover:underline bg-transparent p-0 border-0 cursor-pointer" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="bg-white border border-gray-200 rounded p-8 text-center text-gray-500">
    No events yet. <%= link_to "Create the first one", new_admin_event_path, class: "text-blue-600 hover:underline" %>.
  </div>
<% end %>
