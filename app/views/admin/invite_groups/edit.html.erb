<div class="flex items-center justify-between mb-8">
  <h1 class="text-2xl font-semibold">Edit group</h1>
  <%= link_to "Back", admin_invite_group_path(@invite_group), class: "text-sm text-gray-600 hover:underline" %>
</div>

<%= form_with(model: [:admin, @invite_group], local: true, class: "space-y-5 bg-white border border-gray-200 rounded p-6") do |f| %>
  <% if @invite_group.errors.any? %>
    <div class="rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <p class="font-semibold mb-2"><%= pluralize(@invite_group.errors.count, "error") %> prevented saving:</p>
      <ul class="list-disc list-inside">
        <% @invite_group.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium mb-1" %>
    <%= f.text_field :name, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
  </div>

  <div>
    <%= f.label :email, class: "block text-sm font-medium mb-1" %>
    <%= f.email_field :email, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
  </div>

  <div>
    <%= f.label :address, class: "block text-sm font-medium mb-1" %>
    <%= f.text_field :address, class: "w-full border border-gray-300 rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-gray-400" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit "Save group", class: "bg-gray-900 text-white text-sm px-4 py-2 rounded hover:bg-gray-700 cursor-pointer" %>
    <%= link_to "Cancel", admin_invite_group_path(@invite_group), class: "text-sm text-gray-600 hover:underline" %>
  </div>
<% end %>
