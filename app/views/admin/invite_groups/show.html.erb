<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-semibold"><%= @invite_group.name %></h1>
  <div class="flex items-center gap-4">
    <%= link_to "Back", admin_guests_path(view: "groups"), class: "text-sm text-gray-600 hover:underline" %>
    <%= link_to "Edit", edit_admin_invite_group_path(@invite_group), class: "text-sm text-gray-700 hover:underline" %>
    <%= button_to "Delete group", admin_invite_group_path(@invite_group),
          method: :delete,
          form: { data: { turbo_confirm: "Delete #{@invite_group.name}? This also deletes its #{@invite_group.guests.size} guest#{"s" unless @invite_group.guests.size == 1} and their responses. This cannot be undone." }, class: "inline" },
          class: "text-sm text-red-600 hover:underline bg-transparent p-0 border-0 cursor-pointer" %>
  </div>
</div>

<%# Group details %>
<div class="bg-white border border-gray-200 rounded p-6 mb-6 space-y-2 text-sm">
  <p><span class="text-gray-500">Email:</span> <%= @invite_group.email.presence || "—" %></p>
  <p>
    <span class="text-gray-500">Members:</span>
    <% if @invite_group.guests.any? %>
      <%= safe_join(@invite_group.guests.map { |g| link_to(g.full_name, edit_admin_guest_path(g), class: "text-gray-800 hover:underline") }, ", ") %>
    <% else %>
      —
    <% end %>
  </p>
</div>

<%# WeeCasa tiny homes %>
<div class="bg-white border border-gray-200 rounded p-6">
  <h2 class="font-semibold mb-1">WeeCasa Tiny Homes</h2>
  <p class="text-sm text-gray-500 mb-4">
    When enabled, this group sees a WeeCasa stay panel at the bottom of their RSVP and can tell us
    whether they'd like to stay in the tiny homes.
  </p>

  <%= form_with model: @invite_group, url: admin_invite_group_path(@invite_group), method: :patch, class: "space-y-4" do |f| %>
    <label class="flex items-center gap-2 text-sm text-gray-800">
      <%= f.check_box :weecasa_included, class: "w-4 h-4" %>
      Include this group in the WeeCasa tiny home block
    </label>

    <div>
      <%= f.label :weecasa_response, "Group's response", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.select :weecasa_response,
          [ [ "Yes — would like to stay in the tiny homes", true ], [ "No, thank you", false ] ],
          { include_blank: "No response yet" },
          class: "w-full max-w-md border border-gray-300 rounded px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-gray-400" %>
    </div>

    <%= f.submit "Save", class: "bg-gray-900 text-white px-4 py-2 text-xs uppercase tracking-wider rounded hover:bg-gray-700 cursor-pointer" %>
  <% end %>
</div>
