<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Ali & Brennan" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="The wedding of Ali & Brennan">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Google Fonts: Lora (body). Headings use self-hosted TAN Meringue; accents use Beth Ellen. %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col bg-nasturtium-cream text-nasturtium-forest-dark">
    <%# ── Navigation ── %>
    <header class="border-b border-nasturtium-linen">
      <nav class="max-w-5xl mx-auto px-6 py-5" data-controller="mobile-nav">
        <div class="flex flex-col items-center md:space-y-4">
          <div class="w-full flex items-center justify-between md:justify-center">
            <%= link_to root_path, class: "no-underline" do %>
              <h1 class="font-script text-3xl leading-none text-nasturtium-magenta hover:text-nasturtium-forest transition-colors">
                A & B
              </h1>
            <% end %>

            <%# Hamburger toggle — only shown on mobile %>
            <button type="button"
                    class="md:hidden text-nasturtium-sage hover:text-nasturtium-forest transition-colors p-2 -mr-2"
                    aria-label="Toggle navigation menu"
                    aria-expanded="false"
                    data-mobile-nav-target="button"
                    data-action="mobile-nav#toggle">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
              </svg>
            </button>
          </div>

          <div class="hidden md:flex flex-col md:flex-row items-center space-y-4 md:space-y-0 md:space-x-8 pt-4 md:pt-0 text-sm tracking-widest uppercase"
               data-mobile-nav-target="menu">
            <%= link_to "Home", root_path,
                class: "text-nasturtium-sage hover:text-nasturtium-forest transition-colors",
                data: { action: "mobile-nav#close" } %>
            <%= link_to "Details", events_path,
                class: "text-nasturtium-sage hover:text-nasturtium-forest transition-colors",
                data: { action: "mobile-nav#close" } %>
            <%= link_to "Travel", travel_path,
                class: "text-nasturtium-sage hover:text-nasturtium-forest transition-colors",
                data: { action: "mobile-nav#close" } %>
            <%= link_to "Recommendations", recommendations_path,
                class: "text-nasturtium-sage hover:text-nasturtium-forest transition-colors",
                data: { action: "mobile-nav#close" } %>
            <%= link_to "Registry", registry_path,
                class: "text-nasturtium-sage hover:text-nasturtium-forest transition-colors",
                data: { action: "mobile-nav#close" } %>
            <%= link_to "RSVP", rsvp_path,
                class: "text-nasturtium-sage hover:text-nasturtium-forest transition-colors",
                data: { action: "mobile-nav#close" } %>
          </div>
        </div>
      </nav>
    </header>

    <%# ── Main Content ── %>
    <main class="flex-1">
      <% if notice.present? %>
        <div class="max-w-3xl mx-auto px-6 pt-6">
          <p class="text-nasturtium-forest bg-nasturtium-olive/10 border border-nasturtium-olive/30 rounded px-4 py-3 text-sm">
            <%= notice %>
          </p>
        </div>
      <% end %>

      <% if alert.present? %>
        <div class="max-w-3xl mx-auto px-6 pt-6">
          <p class="text-nasturtium-red bg-nasturtium-red/5 border border-nasturtium-red/20 rounded px-4 py-3 text-sm">
            <%= alert %>
          </p>
        </div>
      <% end %>

      <%= yield %>
    </main>

    <footer class="mt-auto text-center py-8 space-y-2 bg-nasturtium-cream border-t border-nasturtium-linen">
      <%= image_tag "az-divider.png", alt: "", class: "w-full max-w-md mx-auto mb-4" %>
      <p class="font-script text-2xl text-nasturtium-magenta">Ali & Brennan</p>
      <p class="text-xs tracking-widest uppercase text-nasturtium-sage">September 12, 2026 &middot; Lyons, Colorado</p>
    </footer>
  </body>
</html>
