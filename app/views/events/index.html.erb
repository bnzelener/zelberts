<section class="text-nasturtium-forest-dark" style="background-color: #C4C726;">
<div class="max-w-5xl mx-auto px-6 py-20">
  <div class="md:max-w-3xl md:mx-auto">
    <h2 class="font-serif font-light text-5xl mb-2">Schedule</h2>
    <%= image_tag "flower-divider.png", alt: "", class: "h-8 w-auto mt-2 mb-12" %>
  </div>

  <% if @events.any? %>
    <% events_by_day = @events.group_by(&:date) %>
    <% saturday_day = events_by_day.find { |date, _| date.strftime("%A") == "Saturday" } %>
    <% saturday_date = saturday_day&.first %>
    <% saturday_events = saturday_day&.last || [] %>
    <% before_days = saturday_date ? events_by_day.select { |d, _| d < saturday_date } : events_by_day %>
    <% after_days  = saturday_date ? events_by_day.select { |d, _| d > saturday_date } : {} %>

    <%# ── One cream box: lead-up days, then the wedding, then any later days ── %>
    <div class="bg-nasturtium-cream text-nasturtium-forest-dark rounded-lg p-8 md:p-12 text-left shadow-md md:max-w-3xl md:mx-auto">

      <%# Days leading up to the wedding (e.g. Friday) — above "Our big day" %>
      <% before_days.each do |date, events_on_day| %>
        <div class="text-center">
          <p class="font-serif font-light text-2xl text-nasturtium-forest-dark mb-1"><%= date.strftime("%A") %></p>
          <p class="text-xs tracking-[0.3em] uppercase text-nasturtium-forest-dark mb-4"><%= "#{date.strftime('%B')} #{date.day.ordinalize}" %></p>
          <div class="space-y-6">
            <% events_on_day.each do |event| %>
              <div>
                <p class="font-serif font-light text-2xl text-nasturtium-forest-dark mb-1"><%= event.name %></p>
                <% if event.time.present? %><p class="text-sm text-nasturtium-forest-dark"><%= event.time %></p><% end %>
                <% if event.location.present? %><p class="text-sm text-nasturtium-forest-dark mt-1"><%= event.location %></p><% end %>
                <% if event.address.present? %><p class="text-xs text-nasturtium-forest-dark mt-1"><%= event.address %></p><% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>

      <% if before_days.any? %>
        <%= image_tag "flower-divider.png", alt: "", class: "h-8 w-auto mx-auto my-8" %>
      <% end %>

      <% if saturday_date %>
        <%# ── Our big day (Saturday) ── %>
        <p class="font-script text-3xl md:text-4xl text-nasturtium-magenta text-center mb-2">Our big day</p>
        <p class="font-serif font-light text-2xl text-nasturtium-forest-dark text-center mb-1"><%= saturday_date.strftime("%A") %></p>
        <p class="text-xs tracking-[0.3em] uppercase text-nasturtium-forest-dark text-center mb-8"><%= "#{saturday_date.strftime('%B')} #{saturday_date.day.ordinalize}" %></p>

        <%#
          On mobile this stacks in source order: first event (Ceremony + Reception),
          then Details, then the remaining event(s) (After Party). On md+ the Details
          block spans both rows of the right column, so the events stay together in
          the left column and Details sits alongside them on the right.
        %>
        <div class="grid gap-8 md:grid-cols-2 md:gap-x-10 md:gap-y-6">
          <% first_event = saturday_events.first %>
          <% rest_events = saturday_events.drop(1) %>

          <%# First event — left column, top row %>
          <div>
            <p class="font-serif font-light text-2xl text-nasturtium-forest-dark mb-1"><%= first_event.name %></p>
            <% if first_event.time.present? %><p class="text-sm text-nasturtium-forest-dark"><%= first_event.time %></p><% end %>
            <% if first_event.location.present? %><p class="text-sm text-nasturtium-forest-dark mt-1"><%= first_event.location %></p><% end %>
            <% if first_event.address.present? %><p class="text-xs text-nasturtium-forest-dark mt-1"><%= first_event.address %></p><% end %>
          </div>

          <%# ── Spot for more details — right column on md+, between events on mobile ── %>
          <div class="md:row-span-2 pt-8 border-t border-nasturtium-forest-dark/15 md:pt-0 md:border-t-0 md:border-l md:border-nasturtium-forest-dark/15 md:pl-10">
            <p class="text-xs tracking-[0.3em] uppercase text-nasturtium-forest-dark mb-4">Details</p>
            <p class="text-sm text-nasturtium-forest-dark leading-relaxed">
              Ceremony begins promptly at 4&nbsp;pm. Please arrive no later than 3:45&nbsp;pm.
            </p>
            <p class="text-sm text-nasturtium-forest-dark leading-relaxed mt-4">
              Cocktail garden party attire. Think bright colors and floral patterns &mdash;
              your best garden disco chic!
            </p>
            <p class="text-sm text-nasturtium-forest-dark leading-relaxed mt-4">
              Join us at the After Party at the brewery in Lyons. Beer, wine, canned
              cocktails, and food provided!
            </p>
          </div>

          <%# Remaining event(s) — left column, below the first event %>
          <% if rest_events.any? %>
            <div class="space-y-6">
              <% rest_events.each do |event| %>
                <div>
                  <p class="font-serif font-light text-2xl text-nasturtium-forest-dark mb-1"><%= event.name %></p>
                  <% if event.time.present? %><p class="text-sm text-nasturtium-forest-dark"><%= event.time %></p><% end %>
                  <% if event.location.present? %><p class="text-sm text-nasturtium-forest-dark mt-1"><%= event.location %></p><% end %>
                  <% if event.address.present? %><p class="text-xs text-nasturtium-forest-dark mt-1"><%= event.address %></p><% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Days after the wedding (e.g. Sunday) — below the Saturday details %>
      <% after_days.each do |date, events_on_day| %>
        <%= image_tag "flower-divider.png", alt: "", class: "h-8 w-auto mx-auto my-8" %>
        <div class="text-center">
          <p class="font-serif font-light text-2xl text-nasturtium-forest-dark mb-1"><%= date.strftime("%A") %></p>
          <p class="text-xs tracking-[0.3em] uppercase text-nasturtium-forest-dark mb-4"><%= "#{date.strftime('%B')} #{date.day.ordinalize}" %></p>
          <div class="space-y-6">
            <% events_on_day.each do |event| %>
              <div>
                <p class="font-serif font-light text-2xl text-nasturtium-forest-dark mb-1"><%= event.name %></p>
                <% if event.time.present? %><p class="text-sm text-nasturtium-forest-dark"><%= event.time %></p><% end %>
                <% if event.location.present? %><p class="text-sm text-nasturtium-forest-dark mt-1"><%= event.location %></p><% end %>
                <% if event.address.present? %><p class="text-xs text-nasturtium-forest-dark mt-1"><%= event.address %></p><% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center text-nasturtium-forest-dark">
      <p class="text-lg">Details are coming soon. Please check back!</p>
    </div>
  <% end %>

  <%# ── Shuttles ── %>
  <div class="mt-12 bg-nasturtium-cream text-nasturtium-forest-dark rounded-lg p-8 md:p-12 shadow-md md:max-w-3xl md:mx-auto">
    <p class="font-serif font-light text-3xl text-center mb-1">Shuttles</p>
    <p class="text-xs tracking-[0.3em] uppercase text-center mb-6">Saturday, September 12th</p>
    <p class="text-sm leading-relaxed text-center md:max-w-xl md:mx-auto mb-10">
      We&rsquo;re running shuttles on the wedding day between the Home2 Suites room block in
      Longmont, the WeeCasa Tiny Homes in Lyons, the Farmette, and the after party at MainStage
      Brewing. Hop on whichever run works for you &mdash; no sign-up needed.
    </p>

    <div class="grid gap-8 md:grid-cols-2 md:gap-x-10">
      <div class="space-y-8">
        <% [
          ["To the ceremony", [
            ["3:00 PM", "Home2 Suites", "The Lyons Farmette"],
            ["3:20 PM", "Home2 Suites", "The Lyons Farmette"],
            ["3:40 PM", "WeeCasa Tiny Homes", "The Lyons Farmette"]
          ]],
          ["To the after party", [
            ["9:45 PM", "The Lyons Farmette", "MainStage Brewing"],
            ["9:55 PM", "The Lyons Farmette", "MainStage Brewing"],
            ["10:05 PM", "The Lyons Farmette", "MainStage Brewing"]
          ]]
        ].each do |heading, runs| %>
          <div>
            <p class="text-xs tracking-[0.3em] uppercase mb-4"><%= heading %></p>
            <div class="space-y-3">
              <% runs.each do |time, from, to| %>
                <div class="flex gap-4">
                  <p class="font-serif text-lg leading-snug w-24 shrink-0"><%= time %></p>
                  <p class="text-sm leading-snug pt-1"><%= from %> &rarr; <%= to %></p>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <div class="pt-8 border-t border-nasturtium-forest-dark/15 md:pt-0 md:border-t-0 md:border-l md:border-nasturtium-forest-dark/15 md:pl-10">
        <p class="text-xs tracking-[0.3em] uppercase mb-4">Back to the room block</p>
        <div class="space-y-3">
          <% [
            ["9:00 PM", "The Lyons Farmette", "Home2 Suites"],
            ["10:15 PM", "MainStage Brewing", "Home2 Suites"],
            ["11:00 PM", "MainStage Brewing", "Home2 Suites"],
            ["12:00 AM", "MainStage Brewing", "Home2 Suites"]
          ].each do |time, from, to| %>
            <div class="flex gap-4">
              <p class="font-serif text-lg leading-snug w-24 shrink-0"><%= time %></p>
              <p class="text-sm leading-snug pt-1"><%= from %> &rarr; <%= to %></p>
            </div>
          <% end %>
        </div>

        <p class="text-sm leading-relaxed mt-8">
          Staying at WeeCasa? MainStage Brewing is right across the street, so the after party
          shuttles double as your ride home &mdash; and it&rsquo;s a short walk back whenever
          you&rsquo;re ready.
        </p>
      </div>
    </div>

    <p class="text-xs leading-relaxed text-center mt-10 pt-6 border-t border-nasturtium-forest-dark/15">
      Every shuttle seats 29. The ceremony starts promptly at 4&nbsp;pm, so if you want a little
      cushion, catch one of the earlier runs from Home2 Suites.
    </p>
  </div>
</div>

  <%# ── FAQ ── %>
  <div class="max-w-2xl mx-auto mt-20 pb-20 px-6">
    <h2 class="font-serif font-light text-4xl mb-10 text-center">FAQ</h2>

    <div class="space-y-4">
      <details class="group border border-nasturtium-forest/25 rounded">
        <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-left font-serif text-lg text-nasturtium-forest-dark select-none">
          Are kids invited?
          <span class="ml-4 transition-transform duration-200 group-open:rotate-45 text-nasturtium-forest-dark text-2xl leading-none">+</span>
        </summary>
        <div class="px-6 pb-5 text-nasturtium-forest-dark text-sm leading-relaxed">
          While we love your kids and want to see them soon, we've planned our wedding as an adult party and kindly ask that you do not bring kids to the wedding.
        </div>
      </details>

      <details class="group border border-nasturtium-forest/25 rounded">
        <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-left font-serif text-lg text-nasturtium-forest-dark select-none">
          Is there a shuttle?
          <span class="ml-4 transition-transform duration-200 group-open:rotate-45 text-nasturtium-forest-dark text-2xl leading-none">+</span>
        </summary>
        <div class="px-6 pb-5 text-nasturtium-forest-dark text-sm leading-relaxed">
          Yes! On Saturday we&rsquo;re running shuttles from the Home2 Suites room block and the
          WeeCasa Tiny Homes to the Farmette, and back from the Farmette and the after party at
          MainStage Brewing to Home2 Suites. See the shuttle times above for the full schedule.
        </div>
      </details>

      <details class="group border border-nasturtium-forest/25 rounded">
        <summary class="flex items-center justify-between cursor-pointer px-6 py-4 text-left font-serif text-lg text-nasturtium-forest-dark select-none">
          What's the dress code?
          <span class="ml-4 transition-transform duration-200 group-open:rotate-45 text-nasturtium-forest-dark text-2xl leading-none">+</span>
        </summary>
        <div class="px-6 pb-5 text-nasturtium-forest-dark text-sm leading-relaxed">
          <p><strong>Welcome Drinks:</strong> Cocktail attire.</p>
          <p class="mt-3"><strong>Wedding:</strong> Cocktail garden party attire. Think bright colors and floral patterns &mdash; your best garden disco chic! September in Colorado means warm afternoons (likely in the high 70s or low 80s) and cooler in the evenings. Weather permitting, the ceremony, cocktail hour, and dinner will be outside. Dancing and dessert will be indoors. The venue is also mostly grass and some gravel so prepare your footwear accordingly.</p>
        </div>
      </details>
    </div>
  </div>
</div>
</section>
