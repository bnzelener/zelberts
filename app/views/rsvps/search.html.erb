<% content_for :title, "RSVP" %>
<section class="max-w-2xl mx-auto px-6 py-20">
  <div class="text-center mb-12">
    <h1 class="font-serif font-light text-5xl text-nasturtium-forest mb-2">RSVP</h1>
    <div class="w-12 h-px bg-nasturtium-olive mx-auto mt-4 mb-6"></div>
    <p class="text-nasturtium-sage text-lg">Find your invitation to let us know if you can make it.</p>
  </div>

  <%= image_tag "gallery-7.jpg", alt: "Ali and Brennan dancing",
      class: "w-full rounded mb-12 shadow-sm" %>

  <%= form_with url: rsvp_search_path, method: :get, class: "space-y-8" do |f| %>
    <div>
      <%= f.label :q, "Your name", class: "block text-xs tracking-[0.2em] uppercase text-nasturtium-sage mb-2" %>
      <%= f.text_field :q, value: @query,
          autofocus: true,
          class: "w-full border-b border-nasturtium-forest/20 bg-transparent py-3 text-nasturtium-forest-dark font-body focus:border-nasturtium-forest focus:outline-none transition-colors",
          placeholder: "First and last name" %>
      <p class="text-nasturtium-sage/70 text-sm mt-2">Can't find yourself? Try just your last name.</p>
    </div>

    <div class="text-center pt-4">
      <%= f.submit "Find my invitation",
          class: "bg-nasturtium-forest text-nasturtium-cream px-12 py-4 text-sm tracking-[0.2em] uppercase hover:bg-nasturtium-forest-light transition-colors cursor-pointer" %>
    </div>
  <% end %>
</section>
