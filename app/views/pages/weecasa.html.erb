<% content_for :title, "WeeCasa Tiny Homes — Ali & Brennan" %>

<section class="max-w-5xl mx-auto px-6 py-20">
  <div class="text-center mb-12">
    <h1 class="font-serif font-light text-5xl text-nasturtium-forest mb-2">WeeCasa Tiny Homes</h1>
    <div class="w-12 h-px bg-nasturtium-olive mx-auto"></div>
  </div>

  <%# ── Hero image ── %>
  <div class="mb-12">
    <img src="https://images.squarespace-cdn.com/content/v1/65e0d4b8279536632bf6acf1/3f4b12dd-379d-4f4c-8581-3ce713c222f8/IMG_2767+copy.jpg?format=1500w"
         alt="WeeCasa tiny home interior"
         class="w-full h-72 sm:h-96 object-cover rounded border border-nasturtium-linen"
         loading="lazy" />
  </div>

  <%# ── Intro ── %>
  <div class="prose prose-lg mx-auto mb-16">
    <p class="text-center text-nasturtium-sage">
      We've reserved the
      <a href="https://www.weecasa.com" target="_blank" rel="noopener noreferrer"
         class="text-nasturtium-forest font-medium underline decoration-nasturtium-olive/40 underline-offset-2 hover:text-nasturtium-olive transition-colors">WeeCasa Tiny House Resort</a>
      in the heart of Lyons for <strong class="text-nasturtium-forest font-medium">Friday and Saturday nights</strong> —
      all <strong class="text-nasturtium-forest font-medium">22 homes</strong> plus a yurt, indoor gathering space,
      river access, and a fire pit. We'll be staying here with close friends and family and would love for you to stay with us.
    </p>
    <p class="text-center text-nasturtium-sage">
      WeeCasa is just a 5 minute drive from the ceremony venue, right across the street from our
      after party at MainStage Brewing, and across the river from LaVern M. Johnson Park where we'll have
      Decent Bagels on Sunday.
    </p>
    <p class="text-center text-nasturtium-sage">
      Each tiny home is $250 / night and because we've already reserved them, you can Venmo Ali or Brennan
      when you're ready to confirm your stay.
    </p>
  </div>

  <%# ── About WeeCasa ── %>
  <div class="mb-16">
    <h2 class="font-serif font-light text-3xl text-nasturtium-forest text-center mb-8">About the Resort</h2>
    <div class="prose prose-lg mx-auto text-nasturtium-forest-dark">
      <p>
        Billed as “The World's Largest Tiny House Resort,” WeeCasa is a cluster of beautifully
        designed tiny homes tucked into a river canyon in downtown Lyons. Each home pairs a
        minimalist, “live wee, live free” spirit with all the modern comforts you'd want —
        cozy beds, full kitchens or kitchenettes, and thoughtfully crafted interiors that make
        the most of every square foot.
      </p>
      <p>
        The resort is within easy walking distance of the shops, restaurants, and breweries of
        downtown Lyons, and sits right along the St. Vrain River — a peaceful, scenic base camp
        for the weekend and a quick gateway to the foothills and Rocky Mountain National Park.
      </p>
    </div>
  </div>

  <%# ── Photo gallery ── %>
  <div class="mb-16">
    <div class="grid grid-cols-2 gap-3">
      <% [
        ["654c1a80-1a1f-4ab3-a742-d3c6d21fbd61/510-wee-casa-050316.jpg", "A WeeCasa tiny home exterior"],
        ["9516802f-099a-4ca5-aed9-adf0289041c5/IMG_2413+copy.jpg", "Inside a WeeCasa tiny home"],
        ["e3b489e0-82f4-46fa-9e5c-5244feeda2b0/141WeeCasa061120+copy+%281%29.jpg", "A WeeCasa tiny home"],
        ["3ff6682c-8497-44b8-9f1e-5ca8c99ceae2/123-wee-casa-050316.jpg", "Tiny home living space"]
      ].each do |path, alt| %>
        <img src="https://images.squarespace-cdn.com/content/v1/65e0d4b8279536632bf6acf1/<%= path %>?format=750w"
             alt="<%= alt %>"
             class="w-full h-60 object-cover rounded border border-nasturtium-linen"
             loading="lazy" />
      <% end %>
    </div>
  </div>

  <%# ── Where It Is (map) ── %>
  <div class="mb-16">
    <h2 class="font-serif font-light text-3xl text-nasturtium-forest text-center mb-8">Where It Is</h2>
    <div id="weecasa-map" class="w-full h-96 rounded border border-nasturtium-linen z-0"></div>
    <p class="text-center text-xs text-nasturtium-sage mt-3">
      WeeCasa sits in downtown Lyons, about a 5-minute drive from the Lyons Farmette.
    </p>
  </div>

</section>

<%# ── Leaflet CSS & JS from CDN ── %>
<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
          integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
          crossorigin=""></script>
<% end %>

<script>
  (function initWeecasaMap() {
    var el = document.getElementById("weecasa-map");
    if (!el || el._leaflet_id) return;

    // If Leaflet hasn't loaded yet (race on Turbo navigation), retry shortly
    if (typeof L === "undefined") {
      setTimeout(initWeecasaMap, 50);
      return;
    }

    // Coordinates
    var weecasa  = [40.22487, -105.27450];  // WeeCasa — 501 W Main St, Lyons
    var farmette = [40.21470, -105.24130];  // The Lyons Farmette — 4121 Ute Hwy

    var map = L.map("weecasa-map", {
      scrollWheelZoom: false
    });

    // OpenStreetMap tiles (free, no API key)
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 18
    }).addTo(map);

    // Dashed line between the homes and the venue
    L.polyline([weecasa, farmette], {
      color: "#F3A81C",
      weight: 2,
      opacity: 0.7,
      dashArray: "6 4"
    }).addTo(map);

    function markerIcon(color) {
      return L.divIcon({
        className: "",
        html: '<div style="background:' + color + '; width:14px; height:14px; border-radius:50%; border:2px solid white; box-shadow:0 1px 4px rgba(0,0,0,0.3);"></div>',
        iconSize: [14, 14],
        iconAnchor: [7, 7],
        popupAnchor: [0, -9]
      });
    }

    L.marker(weecasa, { icon: markerIcon("#3A8D36") }).addTo(map)
      .bindPopup("<strong>WeeCasa Tiny Homes</strong><br>501 W Main St, Lyons");
    L.marker(farmette, { icon: markerIcon("#F3A81C") }).addTo(map)
      .bindPopup("<strong>The Lyons Farmette</strong><br>4121 Ute Hwy, Lyons")
      .openPopup();

    // Fit map to show both points
    var bounds = L.latLngBounds([weecasa, farmette]);
    map.fitBounds(bounds, { padding: [30, 30] });
  })();
</script>
