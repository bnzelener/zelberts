<%# ── Hero Section ── %>
<section class="relative min-h-[80vh] flex items-end justify-end overflow-hidden">
  <%# Nasturtium illustration as hero background %>
  <div class="absolute inset-0 z-0">
    <%= image_tag "zelberts-header.png",
        alt: "",
        class: "w-full h-full object-cover object-center" %>
  </div>

  <div class="relative z-10 text-right px-10 pb-12 pt-24">
    <h1 class="font-serif font-light text-4xl md:text-6xl tracking-tight text-nasturtium-cream mb-4" style="text-shadow: 0 2px 8px rgba(30, 61, 42, 0.5);">
      Ali & Brennan
    </h1>
    <div class="w-16 h-px bg-nasturtium-cream/60 ml-auto my-8"></div>
    <p class="font-serif text-xl md:text-2xl text-nasturtium-cream font-light tracking-wide" style="text-shadow: 0 1px 4px rgba(30, 61, 42, 0.3);">
      September 12, 2026
    </p>
    <p class="font-serif text-lg text-nasturtium-cream/80 mt-3 tracking-wide" style="text-shadow: 0 1px 4px rgba(30, 61, 42, 0.3);">
      Lyons, Colorado
    </p>
  </div>
</section>

<%# ── Photo + Details ── %>
<section style="background-color: #F7F4ED;" class="py-16">
  <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row md:items-center gap-10">
    <div class="md:w-1/2">
      <%= image_tag "IMG_0022.JPG", alt: "Ali and Brennan", style: "width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px;" %>
    </div>

    <div class="md:w-1/2 text-nasturtium-forest-dark">
      <h2 class="font-serif font-light text-3xl md:text-4xl text-nasturtium-forest-dark mb-6">The Farmette<br>Lyons, Colorado</h2>
      <p class="font-body text-lg leading-relaxed mb-3">Ceremony to begin at 4pm. Please arrive no later than 3:45 pm.</p>
      <p class="font-body text-lg leading-relaxed">Attire is semi-formal garden party.</p>
    </div>
  </div>
</section>

<%# ── Venue Photo ── %>
<section id="venue" class="relative w-full">
  <%= image_tag "lyons-farmette.webp", alt: "The Lyons Farmette",
      class: "w-full h-[50vh] md:h-[70vh] object-cover object-center" %>
  <div class="absolute inset-0 bg-gradient-to-r from-nasturtium-forest-dark/60 via-nasturtium-forest-dark/20 to-transparent"></div>
  <div class="absolute inset-0 flex items-center">
    <div class="max-w-5xl mx-auto px-6 w-full">
      <h2 class="font-serif font-light text-2xl md:text-4xl text-nasturtium-cream" style="text-shadow: 0 1px 6px rgba(30, 61, 42, 0.6);">
        The Farmette, Lyons Colorado
      </h2>
    </div>
  </div>
</section>

