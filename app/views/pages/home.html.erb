<%# ── Hero Section ── %>
<section class="relative min-h-[80vh] overflow-hidden">
  <%# Nasturtium illustration as hero background %>
  <div class="absolute inset-0 z-0">
    <%= image_tag "zelberts-header.png",
        alt: "",
        class: "w-full h-full object-cover object-center" %>
  </div>

  <div class="absolute z-10 bottom-0 right-0 text-right px-6 md:px-10 pb-28 md:pb-40">
    <h1 class="font-serif font-light text-4xl md:text-6xl tracking-tight text-nasturtium-cream" style="text-shadow: 0 2px 8px rgba(30, 61, 42, 0.5);">
      Ali &<br class="md:hidden"> Brennan
    </h1>
  </div>
</section>

<%# ── Photo + Details ── %>
<section style="background-color: #F7F4ED;" class="py-16">
  <div class="max-w-5xl mx-auto px-6 flex flex-col md:flex-row md:items-center gap-10">
    <div class="md:w-1/2">
      <%= image_tag "IMG_0022.JPG", alt: "Ali and Brennan", style: "width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 4px;" %>
    </div>

    <div class="md:w-1/2 text-nasturtium-forest-dark">
      <h2 class="font-serif font-light text-3xl md:text-4xl text-nasturtium-forest-dark mb-6">Welcome to Colorado!</h2>
      <p class="font-body text-lg leading-relaxed">We can't wait to bring our family and friends together in this state that we each fell in love with, and then fell in love with each other in!</p>
    </div>
  </div>
</section>

<%# ── Venue Photo ── %>
<section id="venue" class="relative w-full">
  <%= image_tag "lyons-farmette.webp", alt: "The Lyons Farmette",
      class: "w-full h-[50vh] md:h-[70vh] object-cover object-center" %>
  <div class="absolute inset-0 flex items-center pb-24 md:pb-40">
    <div class="max-w-5xl mx-auto px-6 w-full">
      <h2 class="font-serif font-light text-2xl md:text-4xl text-nasturtium-cream" style="text-shadow: 0 1px 6px rgba(30, 61, 42, 0.6);">
        The Farmette<br>Lyons, Colorado
      </h2>
      <p class="font-serif text-lg md:text-2xl text-nasturtium-cream mt-3" style="text-shadow: 0 1px 6px rgba(30, 61, 42, 0.6);">
        September 12, 2026
      </p>
    </div>
  </div>
</section>

