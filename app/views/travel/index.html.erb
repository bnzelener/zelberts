<section class="text-nasturtium-forest-dark" style="background-color: #C4C726;">
<div class="max-w-3xl mx-auto px-6 py-20">
  <div class="flex flex-col md:flex-row md:items-center gap-8 md:gap-12 mb-16">
    <div class="md:w-1/2">
      <h1 class="font-serif font-light text-5xl text-nasturtium-forest-dark mb-2">Travel</h1>
      <%= image_tag "flower-divider.png", alt: "", class: "h-8 w-auto mt-2 mb-5" %>
      <p class="text-lg text-nasturtium-forest-dark leading-relaxed">
        We&rsquo;re so thankful that so many of you are traveling to Colorado to
        celebrate with us! Denver International Airport (DIA) will be the easiest
        airport to fly into. From there, check out our recommendations below.
      </p>
    </div>
    <div class="md:w-1/2">
      <%= image_tag "travel.jpeg", alt: "Colorado", class: "w-full rounded-lg shadow-md" %>
    </div>
  </div>

  <%# ── Leaflet Map (hidden for now) ── %>
  <%#
  <div class="mb-16">
    <div id="travel-map" class="w-full h-80 rounded border border-nasturtium-linen z-0"></div>
  </div>
  %>

  <%# Getting Around %>
  <div class="mb-16">
    <h2 class="font-serif font-light text-3xl text-nasturtium-forest-dark text-center mb-8">Getting Around</h2>

    <div class="text-center">
      <div class="p-8 bg-nasturtium-cream rounded-lg shadow-md">
        <p class="text-xs tracking-[0.3em] uppercase text-nasturtium-forest-dark mb-3">Car Rentals</p>
        <p class="text-nasturtium-forest-dark">
          Renting a car for the weekend is a great idea if you&rsquo;re looking to
          explore a little further away from the Welcome Drinks in Boulder and
          Wedding day activities on Saturday &amp; Sunday in Lyons.
        </p>
        <p class="text-nasturtium-forest-dark mt-4">
          That said, you can totally get away with not renting a car for the
          weekend. When you land in Denver, you can take a rail to the heart of
          Denver and from there, there are great options into Pearl St. in Boulder.
          And from there, Ubers and Lyfts will be available in all of the cities
          we&rsquo;ll be in.
        </p>
      </div>
    </div>
  </div>

  <%# Accommodations %>
  <div class="mb-16">
    <h2 class="font-serif font-light text-3xl text-nasturtium-forest-dark text-center mb-8">Where to Stay</h2>

    <div class="text-center p-10 bg-nasturtium-cream rounded-lg shadow-md">
      <p class="text-xs tracking-[0.3em] uppercase text-nasturtium-forest-dark mb-3">Room Block</p>
      <p class="font-serif text-2xl text-nasturtium-forest-dark mb-2">Home2 Suites by Hilton Longmont</p>
      <p class="text-nasturtium-forest-dark mb-6">710 South Sherman Street, Longmont, CO 80501</p>

      <div class="flex items-center justify-center gap-6">
        <%# TODO: Replace # with your actual room block booking link %>
        <a href="https://www.hilton.com/en/book/reservation/rooms/?ctyhocn=QWMLCHT&arrivalDate=2026-09-11&departureDate=2026-09-13&groupCode=CHTZBW&room1NumAdults=1"
           target="_blank"
           rel="noopener noreferrer"
           class="inline-block bg-nasturtium-forest text-nasturtium-cream px-8 py-3 text-sm tracking-[0.2em] uppercase hover:bg-nasturtium-forest-light transition-colors">
          Book Room Block
        </a>
      </div>

      <p class="text-nasturtium-forest-dark text-sm mt-6">We&rsquo;ll have a shuttle available to and from this hotel to the venue on Saturday.</p>
    </div>
  </div>

  <%# Other Options %>
  <div>
    <h2 class="font-serif font-light text-3xl text-nasturtium-forest-dark text-center mb-8">Other Options</h2>

    <div class="grid md:grid-cols-2 gap-8">
      <div class="text-center p-8 bg-nasturtium-cream rounded-lg shadow-md">
        <p class="text-xs tracking-[0.3em] uppercase text-nasturtium-forest-dark mb-3">Longmont</p>
        <p class="text-nasturtium-forest-dark">~20 minutes from venue</p>
        <p class="text-nasturtium-forest-dark text-sm mt-2">Longmont has a cute downtown to walk around and there will be a shuttle to and from the Home2 Suites that anyone staying in Longmont can utilize.</p>
      </div>

      <div class="text-center p-8 bg-nasturtium-cream rounded-lg shadow-md">
        <p class="text-xs tracking-[0.3em] uppercase text-nasturtium-forest-dark mb-3">Boulder</p>
        <p class="text-nasturtium-forest-dark">~30 minutes from venue</p>
        <p class="text-nasturtium-forest-dark text-sm mt-2">There&rsquo;s a CU home game the day of our wedding so availability may be limited and prices may be higher, but a great option for exploring and walkability.</p>
      </div>
    </div>
  </div>
</div>
</section>

<% if false # Leaflet map hidden for now %>
<%# ── Leaflet CSS & JS from CDN ── %>
<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
          integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
          crossorigin=""></script>
<% end %>

<script>
  (function initMap() {
    var el = document.getElementById("travel-map");
    if (!el || el._leaflet_id) return;

    // If Leaflet hasn't loaded yet (race on Turbo navigation), retry shortly
    if (typeof L === "undefined") {
      setTimeout(initMap, 50);
      return;
    }

    // Coordinates
    var denver    = [39.8561, -104.6737];  // Denver International Airport
    var anchorage = [61.2181, -149.9003];  // Anchorage, AK
    var bayshore  = [40.7254, -73.2454];   // Bay Shore, Long Island, NY
    var toronto   = [43.6532, -79.3832];   // Toronto, ON

    var map = L.map("travel-map", {
      scrollWheelZoom: false
    }).setView([48, -105], 3);

    // OpenStreetMap tiles (free, no API key)
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 18
    }).addTo(map);

    // Curved line helper — creates an arc between two points
    function curvedLine(start, end, color) {
      var latlngs = [];
      var steps = 50;
      for (var i = 0; i <= steps; i++) {
        var t = i / steps;
        var lat = start[0] + t * (end[0] - start[0]);
        var lng = start[1] + t * (end[1] - start[1]);
        // Add arc by offsetting latitude
        var arc = Math.sin(t * Math.PI) * Math.abs(end[1] - start[1]) * 0.08;
        lat += arc;
        latlngs.push([lat, lng]);
      }
      return L.polyline(latlngs, {
        color: color,
        weight: 2,
        opacity: 0.6,
        dashArray: "6 4"
      });
    }

    // Travel lines
    curvedLine(anchorage, denver, "#F3A81C").addTo(map);
    curvedLine(bayshore, denver, "#F3A81C").addTo(map);
    curvedLine(toronto, denver, "#F3A81C").addTo(map);

    // Marker icon
    var markerIcon = L.divIcon({
      className: "",
      html: '<div style="background:#3A8D36; width:12px; height:12px; border-radius:50%; border:2px solid white; box-shadow:0 1px 4px rgba(0,0,0,0.3);"></div>',
      iconSize: [12, 12],
      iconAnchor: [6, 6],
      popupAnchor: [0, -8]
    });

    L.marker(denver, { icon: markerIcon }).addTo(map)
      .bindPopup("<strong>Denver, CO</strong><br>Fly into DEN");
    L.marker(anchorage, { icon: markerIcon }).addTo(map)
      .bindPopup("<strong>Anchorage, AK</strong><br>Brennan's stomping grounds");
    L.marker(bayshore, { icon: markerIcon }).addTo(map)
      .bindPopup("<strong>Bay Shore, Long Island</strong><br>Ali's stomping grounds");
    L.marker(toronto, { icon: markerIcon }).addTo(map)
      .bindPopup("<strong>Toronto, ON</strong><br>Family from the north");

    // Fit map to show all points
    var bounds = L.latLngBounds([denver, anchorage, bayshore, toronto]);
    map.fitBounds(bounds, { padding: [30, 30] });
  })();
</script>
<% end %>
